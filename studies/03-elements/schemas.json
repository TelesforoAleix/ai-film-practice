{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-practice:study-03:elements-v1",
  "title": "Proposed element and version records; requires cross-record validation",
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "film_id",
        "id"
      ],
      "properties": {
        "film_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study",
        "film_id",
        "entity_ids",
        "source_path",
        "excerpt",
        "evidence_label",
        "competing_explanation",
        "denominator",
        "confidence_rationale"
      ],
      "properties": {
        "study": {
          "type": "string",
          "minLength": 1
        },
        "film_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_label": {
          "enum": [
            "observed",
            "creator-stated",
            "inferred",
            "associated",
            "experimentally supported",
            "proposed"
          ]
        },
        "competing_explanation": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "confidence_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "value",
        "state",
        "channel",
        "scope",
        "evidence"
      ],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "state": {
          "enum": [
            "declared",
            "inferred",
            "proposed",
            "empty",
            "unknown",
            "unavailable"
          ]
        },
        "channel": {
          "enum": [
            "prose",
            "reference_metadata",
            "parameter",
            "image",
            "audio",
            "mixed",
            "unknown"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unknown",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_key",
        "producer_key",
        "media_kind",
        "role",
        "content_state",
        "evidence"
      ],
      "properties": {
        "asset_key": {
          "$ref": "#/$defs/key"
        },
        "producer_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "unknown"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "content_state": {
          "enum": [
            "unobservable",
            "verified_by_review"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "name",
        "source_category",
        "description",
        "identity_claims",
        "variant_axes",
        "version_keys",
        "external_reference_keys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": [
            "character",
            "outfit",
            "pose",
            "location",
            "layout",
            "prop",
            "material",
            "palette",
            "lighting",
            "style_reference",
            "voice_reference",
            "unknown"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "$ref": "#/$defs/claim"
        },
        "identity_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "variant_axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "version_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "external_reference_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_version_key",
        "relationship",
        "changed_properties",
        "identity_basis",
        "evidence"
      ],
      "properties": {
        "parent_version_key": {
          "$ref": "#/$defs/key"
        },
        "relationship": {
          "enum": [
            "explicit_revision",
            "inferred_derivative",
            "proposed_variant"
          ]
        },
        "changed_properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "identity_basis": {
          "$ref": "#/$defs/claim"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "property_names",
        "task_key",
        "source_binding_state",
        "source_asset_key",
        "evidence"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "property_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "task_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_binding_state": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "source_asset_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actor_id",
        "decision_event_id",
        "scope",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "candidate",
            "in_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "rejected",
                  "superseded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_event_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_key",
        "asset_key",
        "reference_key",
        "asset_role",
        "parameter_path",
        "meaning",
        "evidence"
      ],
      "properties": {
        "consumer_key": {
          "$ref": "#/$defs/key"
        },
        "asset_key": {
          "$ref": "#/$defs/key"
        },
        "reference_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset_role": {
          "type": "string",
          "minLength": 1
        },
        "parameter_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "meaning": {
          "const": "further_work"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "element_key",
        "sources",
        "properties",
        "package_kind",
        "package_state",
        "parents",
        "authority",
        "review",
        "uses"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "element_key": {
          "$ref": "#/$defs/key"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "package_kind": {
          "enum": [
            "single_image",
            "multi_angle",
            "expression_sheet",
            "location_board",
            "blockout",
            "style_sheet",
            "named_element",
            "generic_reference_sheet",
            "unknown"
          ]
        },
        "package_state": {
          "enum": [
            "requested",
            "creator_stated",
            "attached",
            "verified_by_review",
            "unknown"
          ]
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "authority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authority"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/use"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elements",
    "versions"
  ],
  "properties": {
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  }
}
